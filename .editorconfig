root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{js,ts,mjs,cjs,jsx,tsx}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml,toml,md}]
indent_style = space
indent_size = 2

[*.{kt,swift}]
indent_style = space
indent_size = 4

[*.{css,html}]
indent_style = space
indent_size = 2
